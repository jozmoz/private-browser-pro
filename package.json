{
  "name": "private-browser-pro",
  "version": "1.0.0",
  "description": "Professional Anti-Detect Browser Manager with isolated fingerprint spoofing, zero-data ephemeral sessions, and proxy tunneling.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "anti-detect",
    "browser-fingerprint",
    "chromium",
    "privacy-browser",
    "electron",
    "stealth",
    "proxy-tunnel",
    "zero-data"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.jozmoz.privatebrowser",
    "productName": "Private Browser Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!data/chromium/**",
      "!data/.sessions/**",
      "!data/profiles_storage/**",
      "!data/.stealth-cache/**"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
